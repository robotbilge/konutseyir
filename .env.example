# Only a public, working contact address. Never put API secrets in VITE_ variables.
VITE_CONTACT_EMAIL=

# Server-only Cloudflare Worker secret. Never expose through VITE_ variables or client code.
TCMB_EVDS_API_KEY=
# Configurable non-secret warning threshold used by the listing comparison.
TCMB_COMPARISON_THRESHOLD_PERCENT=20
